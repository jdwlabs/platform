{
  "title": "Repo health",
  "uid": "platform-repo-health",
  "description": "Cross-repo CI health on main for the four jdwlabs repos, from github-repo-health-exporter (tenants/platform/services/github-repo-health-exporter). Every panel reads a series the exporter actually emits: jdwlabs_repo_ci_consecutive_failures, jdwlabs_repo_ci_main_failure_ratio, jdwlabs_repo_health_exporter_sample_size, jdwlabs_repo_health_exporter_refreshes_total, jdwlabs_repo_health_exporter_last_refresh_timestamp_seconds. Alerts on the same series live in rules-github-repo-health.yaml.",
  "tags": [
    "platform",
    "github",
    "ci"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "CI on main",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Workflows failing 3+ consecutive runs",
      "description": "Count of (repo, workflow) pairs whose newest main-branch runs are all failures \u2014 the RepoCiWorkflowFailingOnMain threshold.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(jdwlabs_repo_ci_consecutive_failures >= 3) or vector(0)",
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Workflows failing 7+ consecutive runs",
      "description": "A week of red for a daily schedule \u2014 the critical RepoCiWorkflowFailingOnMainWeek threshold.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(jdwlabs_repo_ci_consecutive_failures >= 7) or vector(0)",
          "refId": "A"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Minutes since last GitHub refresh",
      "description": "Every CI series freezes when refreshes stop; RepoHealthExporterStale fires past 60.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(time() - jdwlabs_repo_health_exporter_last_refresh_timestamp_seconds) / 60",
          "refId": "A"
        }
      ],
      "id": 4
    },
    {
      "type": "table",
      "title": "Consecutive failures on main, by workflow",
      "description": "Sorted so the longest streak is on top. Sample size is how many completed runs the value was computed from \u2014 a streak of 2 over a sample of 2 is a workflow that has never passed, not one that regressed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Consecutive failures"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    },
                    {
                      "color": "orange",
                      "value": 3
                    },
                    {
                      "color": "red",
                      "value": 7
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failure ratio"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.2
                    },
                    {
                      "color": "red",
                      "value": 0.5
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "jdwlabs_repo_ci_consecutive_failures",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "expr": "jdwlabs_repo_ci_main_failure_ratio",
          "refId": "B",
          "format": "table",
          "instant": true
        },
        {
          "expr": "jdwlabs_repo_health_exporter_sample_size",
          "refId": "C",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "pod": true,
              "service": true,
              "container": true,
              "endpoint": true
            },
            "renameByName": {
              "repo": "Repo",
              "workflow": "Workflow",
              "Value #A": "Consecutive failures",
              "Value #B": "Failure ratio",
              "Value #C": "Sample size"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Consecutive failures",
                "desc": true
              }
            ]
          }
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Consecutive failures on main",
      "description": "One series per (repo, workflow). Recomputed every 15m from the newest 100 completed main-branch runs, so a step down is a green run landing, not time passing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "lineInterpolation": "stepAfter",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "jdwlabs_repo_ci_consecutive_failures",
          "legendFormat": "{{repo}} / {{workflow}}",
          "refId": "A"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Failure ratio on main",
      "description": "Failed runs over completed runs in the same 100-run window.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineInterpolation": "stepAfter",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "jdwlabs_repo_ci_main_failure_ratio",
          "legendFormat": "{{repo}} / {{workflow}}",
          "refId": "A"
        }
      ],
      "id": 7
    },
    {
      "type": "row",
      "title": "Exporter",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Refresh cycles per hour, by outcome",
      "description": "One increment per repo per cycle. Steady 'failed' with healthy 'ok' is one repo the App cannot read; RepoHealthExporterRefreshFailing fires at 3/h.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "increase(jdwlabs_repo_health_exporter_refreshes_total[1h])",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "id": 9
    },
    {
      "type": "stat",
      "title": "Scrape target up",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "UP"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "up{job=\"github-repo-health-exporter\", namespace=\"monitoring\"}",
          "refId": "A"
        }
      ],
      "id": 10
    }
  ]
}