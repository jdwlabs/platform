{
  "title": "cert-manager",
  "uid": "platform-cert-manager",
  "description": "Certificate expiry and issuer/controller health for cert-manager. Every metric here is confirmed live on this cluster's Prometheus (certmanager_certificate_expiration_timestamp_seconds, certmanager_certificate_ready_status, certmanager_issuer_ready_status, certmanager_clusterissuer_ready_status, certmanager_controller_sync_error_count) — cert-manager already has a ServiceMonitor (tenants/platform/services/cert-manager/postInstall/servicemonitor.yaml), this dashboard was the missing piece named in docs/observability/DASHBOARDS-AND-MULTITENANCY.md §4 (JDWLABS-419).",
  "tags": ["platform", "cert-manager"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-30d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Certificate expiry",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Days until expiry, by certificate",
      "description": "The direct industry-standard ask for a cert-manager dashboard — a sortable table so the soonest-expiring cert is never buried in a graph.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 14 },
              { "color": "green", "value": 30 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(certmanager_certificate_expiration_timestamp_seconds - time()) / 86400",
          "legendFormat": "{{name}} (issuer: {{issuer_name}})",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Certificates not Ready",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 11 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "count(certmanager_certificate_ready_status{condition=\"True\"} == 0)", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Issuers not Ready",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 11 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "count((certmanager_issuer_ready_status{condition=\"True\"} == 0)) + count((certmanager_clusterissuer_ready_status{condition=\"True\"} == 0))", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Controller sync errors (1h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 11 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 }] }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "sum(increase(certmanager_controller_sync_error_count[1h]))", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "ACME (letsencrypt) client",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "ACME request rate by status",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(certmanager_http_acme_client_request_count[5m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "ACME request average duration",
      "description": "certmanager_http_acme_client_request_duration_seconds has no _bucket series on this cluster (confirmed live) — average from count/sum, not a real percentile.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(certmanager_http_acme_client_request_duration_seconds_sum[5m])) / sum(rate(certmanager_http_acme_client_request_duration_seconds_count[5m]))",
          "legendFormat": "avg",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    }
  ]
}
